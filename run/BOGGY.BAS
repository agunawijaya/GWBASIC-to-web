590 PR=10
600 LOCATE 11,1,O:PRINT SPACE$(24):PRINT SPACE$(24):PRINT SPACE$(24)
610 FOR I=1 TO 3
620     LOCATE PR+1,1,0
630     IF R(I)=99 THEN PRINT"You've Killed Number" I:PR=PR+1:GOTO 750
640     IF ROW=R(I) AND COL=C(I) THEN PRINT"You Just Killed Number" I:GOSUB 920:        LOCATE ERSROW,ERSCOL,0:COLOR 20,0:PRINT CHR$(26)CHR$(2)CHR$(27):                COLOR 3,0:NUMFOUND=NUMFOUND+1:R(I)=99:PR=PR+1:HIT=1:GOTO 750
650     PRINT"GO ";
660     IF ROW=R(I) AND COL<C(I) THEN PRINT"East For No" I:GOTO 740
670     IF ROW=R(I) AND COL>C(I) THEN PRINT"West For No" I:GOTO 740
680     IF COL=C(I) AND ROW<R(I) THEN PRINT"South For No" I:GOTO 740
690     IF COL=C(I) AND ROW>R(I) THEN PRINT"North For No" I:GOTO 740
700     IF ROW<R(I) AND COL<C(I) THEN PRINT"Southeast For No" I:GOTO 740
710     IF ROW<R(I) AND COL>C(I) THEN PRINT"Southwest For No" I:GOTO 740
720     IF ROW>R(I) AND COL<C(I) THEN PRINT"Northeast For No" I:GOTO 740
730     IF ROW>R(I) AND COL>C(I) THEN PRINT"Northwest For No" I:GOTO 740
740 PR=PR+1
750 NEXT I
760 IF HIT=0 THEN GOSUB 920 ELSE HIT=0
770 IF NUMFOUND=3 THEN GOSUB 1050:CLS:LOCATE 5,27,0:PRINT"Congratulations, You Win":PRINT;TAB(30);"In Only" GUESS "Guesses":GOTO 860
