1000 REM Author Les Davids
1010 DIM SUIT$(4),CARD$(52),DECK$(52)
1020 DIM FIG$(5,5)
1030 DEFINT A-Z
1040 DIM DECK(52),PHAND$(26),CHAND$(26)
1050 DIM TEST(52),OLDHAND$(25)
1060 SCREEN 0,1:COLOR 0,2:CLS
1070 KEY OFF
1080 LOCATE 2,9
1090 PRINT "C R A Z Y   E I G H T S"
1100 DIM VALUE$(13),VALUE(13)
1110 LOCATE 4,1
1120 PRINT"The objective of the game is to get rid"
1130 PRINT"of all your cards by placing them on"
1140 PRINT"the discard pile."
1150 PRINT"You can play a card if you have the "
1160 PRINT"same suit, the same number (in which"
1170 PRINT"case the suit changes), or at any time"
1180 PRINT"you can play an eight. If you play an"
1190 PRINT"eight you will be prompted for new suit (h,c,s,d)."
1200 PRINT"If you cannot go, hit the space bar."
1210 PRINT"You will then be dealt a new card."
1220 PRINT
1230 PRINT"Game will end at 100 points."
1240 PRINT"The winner receives points from the"
1250 PRINT"losers hand. Points are equal to "
1260 PRINT"face value. Face cards are 10 each,"
1270 PRINT"aces are worth 15."
1280 LOCATE 22,15:INPUT "NAME ",N$
1290 CLS: LOCATE 2,9
1300 DATA "A","2","3","4","5","6","7"
1310 DATA "8","9","0","J","Q","K"
1320 DATA 15,2,3,4,5,6,7,8,9,10,10,10,10
1330 FOR I=1 TO 13:READ VALUE$(I):NEXT I
1340 FOR I=1 TO 13:READ VALUE(I):NEXT I
1350 PRINT "C R A Z Y   E I G H T S"
1360 LOCATE 5,2:PRINT"SCORE"
1370 LOCATE 6,4:PRINT "COMPUTER";CSCORE
1380 LOCATE 7,4:PRINT N$;PSCORE
1390 FOR I=1 TO 40
1400 LOCATE 9,I: PRINT CHR$(205)
1410 NEXT I
1420 REM ** shuffle cards
1430 GOSUB 2500
1440 REM ** deal cards
1450 COLOR 7,7
1460 FOR I = 1 TO 8
1470 J=1+((I-1)*2)
1480 PHAND$(I)=DECK$(J)
1490 CHAND$(I)=DECK$(J+1)
1500 NEXT I
1510 NEXTCARD = 18
1520 UPCARD$ = DECK$(17)
1530 PCARDS=8
1540 CCARDS=8
1550 REM ** sort player's hand
1560 SORTTEST=1
1570 WHILE+ SORTTEST
1580 SORTTEST=0
1590 FOR I=1 TO PCARDS-1
1600 CHAR1$=MID$(PHAND$(I),3)
1610 CHAR2$=MID$(PHAND$(I+1),3)
1620 IF CHAR1$>CHAR2$ THEN SWAP PHAND$(I),PHAND$(I+1): SORTTEST = 1
1630 NEXT I
1640 WEND
1650 THE$="   ": GOSUB 3370
1660 THE$=UPCARD$: GOSUB 3460
1670 ROW=4:COL=19:GOSUB 3380
1680 ROW=10
1690 FOR I=1 TO 6
1700 IF I>(PCARDS+1) THEN 1750
1710 IF PHAND$(I)=OLDHAND$(I) THEN 1770
1720 OLDHAND$(I)=PHAND$(I)
1730 THE$=PHAND$(I): GOSUB 3460
1740 COL=1+(6*(I-1)): GOSUB 3380
1750 LOCATE 15,(2+((I-1)*6))
1760 IF I<=PCARDS THEN PRINT I ELSE PRINT "  "
1770 NEXT I
1780 ROW=17
1790 FOR I=7 TO (PCARDS+1)
1800 J=I-6
1810 IF PHAND$(I)=OLDHAND$(I) THEN 1950
1820 OLDHAND$(I)=PHAND$(I)
1830 THE$=PHAND$(I): GOSUB 3460
1840 COL=1+(6*(J-1)): GOSUB 3380
1850 LOCATE 22,(2+((I-7)*6))
1860 IF I=(PCARDS+1) THEN PRINT "  ": GOTO 1950
1870 IF I<10 THEN PRINT I
1880 IF I = 10 THEN PRINT " A"
1890 IF I = 11 THEN PRINT " B"
1900 IF I = 12 THEN PRINT " C"
1910 IF I = 13 THEN PRINT " D"
1920 IF I = 14 THEN PRINT " E"
1930 IF I = 15 THEN PRINT " F"
1940 IF I = 16 THEN PRINT " G"
1950 NEXT I
1960 LOCATE 23,20:PRINT"ENTER YOUR PLAY"
1970 IN$=INKEY$:IF IN$="" THEN 1970
1980 LOCATE 7,29:PRINT"           "
1990 LOCATE 23,20:PRINT"THINKING       "
2000 IF IN$<>" " THEN 2080
2010 IF TAKE=1 THEN 2420
2020 PCARDS=PCARDS+1
2030 IF NEXTCARD = 53 THEN 3850
2040 PHAND$(PCARDS)=DECK$(NEXTCARD)
2050 NEXTCARD=NEXTCARD+1
2060 TAKE = 1
2070 GOTO 1560
2080 IF IN$>"9" THEN 2110
2090 IN=VAL(IN$)
2100 GOTO 2210
2110 IF IN$="a" THEN IN=10
2120 IF IN$="b" THEN IN=11
2130 IF IN$="c" THEN IN=12
2140 IF IN$="d" THEN IN=13
2150 IF IN$="e" THEN IN=14
2160 IF IN$="e" THEN IN=15
2170 IF IN$<"a" OR IN$>"e" THEN 2180            ELSE 2210
2180 LOCATE 23,20
2190 PLAY "mfo1fd":PRINT "WRONG CARD"
2200 GOTO 1960
2210 IN$=PHAND$(IN)
2220 IF MID$(IN$,2,1)="8" THEN 2280
2230 IF MID$(IN$,1,2) = MID$(UPCARD$,1,2) THEN 2370
2240 IF MID$(IN$,3,1) = MID$(UPCARD$,3,1) THEN 2370
2250 LOCATE 23,20
2260 PRINT "WRONG CARD"
2270 GOTO 1960
2280 LOCATE 23,20: PRINT"WHAT SUIT?"
2290 S$=INKEY$: IF S$="" THEN 2290
2300 IF S$ = "c" THEN 2350
2310 IF S$ = "d" THEN 2350
2320 IF S$ = "h" THEN 2350
2330 IF S$ = "s" THEN 2350
2340 GOTO 2290
2350 REM ** switch suit
2360 MID$(IN$,3,1)=MID$(S$,1,1)
2370 TAKE = 0
2380 UPCARD$ = IN$
2390 IF IN = PCARDS THEN 2410
2400 PHAND$(IN) = PHAND$(PCARDS)
2410 PCARDS = PCARDS - 1
2420 PHAND$(PCARDS+1) = "   "
2430 IF PCARDS=0 THEN 3730
2440 TAKE=0
2450 GOSUB 2860
2460 IF CCARDS = 0 THEN 3730
2470 TAKE=0
2480 GOTO 1550
2500 REM ******* shuffle routine ******
2510 LOCATE 6,29: PRINT"NEW GAME"
2520 TIM$=MID$(TIME$,4,2)
2530 TIM$=TIM$+MID$(TIME$,7,2)
2540 SEED=VAL(TIM$)
2550 RANDOMIZE(SEED)
2560 COUNT = 1
2570 WHILE+ COUNT < 53
2580 NUMBR=100*RND
2590 IF NUMBR > 52 THEN 2580
2600 IF NUMBR = 0 THEN 2580
2610 IF TEST(NUMBR) = 1 THEN 2580
2620 TEST(NUMBR) = 1
2630 DECK(COUNT) = NUMBR
2640 COUNT = COUNT + 1
2650 WEND
2660 IF PSCORE <>0 OR CSCORE<>0 THEN 2810
2670 DATA "c","d","h","s"
2680 FOR I=1 TO 4
2690 READ SUIT$(I)
2700 NEXT I
2710 DATA " A"," 2"," 3"," 4"," 5"," 6"," 7"
2720 DATA " 8"," 9","10"," J"," Q"," K"
2730 FOR I = 1 TO 4
2740 FOR J = 1 TO 13
2750 N = J+((I-1)*13)
2760 READ CARD$(N)
2770 CARD$(N)=CARD$(N)+SUIT$(I)
2780 NEXT J
2790 RESTORE 2710
2800 NEXT I
2810 FOR I=1 TO 52
2820 DECK$(I) = CARD$(DECK(I))
2830 PLAY "mbl64t255o0aa-p64"
2840 NEXT I
2850 RETURN
2860 REM ** computer section
2870 REM ** sort computer's hand
2880 TAKE=0
2890 SORTTEST=1
2900 WHILE+ SORTTEST
2910 SORTTEST=0
2920 FOR I=1 TO CCARDS-1
2930 CHAR1$=MID$(CHAND$(I),3)
2940 CHAR2$=MID$(CHAND$(I+1),3)
2950 IF CHAR1$>CHAR2$ THEN SWAP CHAND$(I),CHAND$(I+1): SORTTEST = 1
2960 NEXT I
2970 WEND
2980 REM ** look for suit
2990 FOR IN=1 TO CCARDS
3000 S$=MID$(UPCARD$,3,1)
3010 T$=MID$(CHAND$(IN),3,1)
3020 IF S$=T$ AND MID$(CHAND$(IN),2,1)<>"8" THEN 3320
3030 NEXT IN
3040 REM ** look for number
3050 FOR IN=1 TO CCARDS
3060 S$=MID$(UPCARD$,1,2)
3070 T$=MID$(CHAND$(IN),1,2)
3080 IF S$=T$ THEN 3320
3090 NEXT IN
3100 REM ** look for eight
3110 FOR IN = 1 TO CCARDS
3120 IF MID$(CHAND$(IN),2,1)="8" THEN 3240
3130 NEXT IN
3140 REM ** take another card
3150 IF TAKE = 1 THEN TAKE=0: RETURN
3160 TAKE = 1
3170 CCARDS=CCARDS+1
3180 CHAND$(CCARDS)=DECK$(NEXTCARD)
3190 NEXTCARD=NEXTCARD+1
3200 LOCATE 6,29:PRINT "CARDS ";CCARDS
3210 LOCATE 7,29: PRINT"TOOK CARD"
3220 IF NEXTCARD=53 THEN 3850
3230 GOTO 2890
3240 REM ** space for playing 8
3250 IF IN=1 THEN S$=MID$(CHAND$(2),3,1) ELSE S$=MID$(CHAND$(1),3,1)
3260 MID$(CHAND$(IN),3,1)=S$
3270 LOCATE 7,29
3280 IF S$="c" THEN PRINT"CLUBS    "
3290 IF S$="d" THEN PRINT"DIAMONDS "
3300 IF S$="h" THEN PRINT"HEARTS   "
3310 IF S$="s" THEN PRINT"SPADES   "
3320 UPCARD$=CHAND$(IN)
3330 IF IN <> CCARDS THEN CHAND$(IN)=CHAND$(CCARDS)
3340 CCARDS=CCARDS-1
3350 LOCATE 6,29:PRINT "CARDS ";CCARDS
3360 IF CCARDS=1 THEN LOCATE 7,29: PRINT"LAST CARD":SOUND 400,5
3370 RETURN
3380 REM ** print a card
3390 FOR SI=1 TO 5
3400 FOR SJ = 1 TO 5
3410 LOCATE (ROW+(SI-1)),(COL+(SJ-1))
3420 PRINT FIG$(SI,SJ)
3430 NEXT SJ,SI
3440 COLOR 0,2
3450 RETURN
3460 REM ** create figure
3470 IF PASS = 1 THEN 3630
3480 PASS=1
3490 FIG$(2,4)=" "
3500 FIG$(3,4)=" "
3510 FIG$(3,2)=" "
3520 FIG$(4,2)=" "
3530 FIG$(1,1)=CHR$(201)
3540 FIG$(1,5)=CHR$(187)
3550 FIG$(5,1)=CHR$(200)
3560 FIG$(5,5)=CHR$(188)
3570 FOR SI=1 TO 3
3580 FIG$(1,SI+1)=CHR$(205)
3590 FIG$(5,SI+1)=CHR$(205)
3600 FIG$(SI+1,1)=CHR$(186)
3610 FIG$(SI+1,5)=CHR$(186)
3620 NEXT SI
3630 IF THE$="   " THEN FOR SI=1 TO 5: FOR SJ=1 TO 5: COLOR 7,2: FIG$(SI,SJ)=" ":NEXT SJ,SI: PASS=0: RETURN
3640 COLOR 7,2:FIG$(2,3)=" "
3650 FIG$(4,3)=" "
3660 IF MID$(THE$,1,1)=" " THEN FIG$(2,2)=MID$(THE$,2,1): FIG$(4,4)=FIG$(2,2) ELSE FIG$(2,2)="1": FIG$(2,3)="0": FIG$(4,3)="1":FIG$(4,4)="0"
3670 S$=MID$(THE$,3,1)
3680 IF S$="d" THEN FIG$(3,3)=CHR$(4):COLOR 4,7
3690 IF S$="c" THEN FIG$(3,3)=CHR$(5):COLOR 0,7
3700 IF S$="h" THEN FIG$(3,3)=CHR$(3):COLOR 4,7
3710 IF S$="s" THEN FIG$(3,3)=CHR$(6):COLOR 0,7
3720 RETURN
3730 LOCATE 7,29
3740 IF PCARDS=0 THEN PRINT"!!YOU WIN" ELSE PRINT"!! I WIN "
3750 FOR SI=1 TO PCARDS
3760 SPHAND$=SPHAND$+PHAND$(SI)
3770 FOR SJ=1 TO 13
3780 IF MID$(PHAND$(SI),2,1)=MID$(VALUE$(SJ),1,1) THEN CSCORE=CSCORE+VALUE(SJ)
3790 NEXT SJ,SI
3800 FOR SI=1 TO CCARDS
3810 SCHAND$=SCHAND$+CHAND$(SI)
3820 FOR SJ=1 TO 13
3830 IF MID$(CHAND$(SI),2,1)=MID$(VALUE$(SJ),1,1) THEN PSCORE=PSCORE+VALUE(SJ)
3840 NEXT SJ,SI
3850 FOR SI=1 TO 52
3860 TEST(SI)=0
3870 NEXT SI
3880 IF PSCORE<100 AND CSCORE<100 THEN 1360
3890 LOCATE 6,4:PRINT "COMPUTER";CSCORE
3900 LOCATE 7,4:PRINT N$;PSCORE
3910 PRINT"thank you"
3920 LOCATE 24,20,0:PRINT "WANT ANOTHER GAME? ";
3930 KY$=INKEY$: IF KY$="" THEN 3930
3940 IF KY$="y" OR KY$="Y" THEN RUN ELSE CLS:END
