680   PRINT I;
690 NEXT I
700 COLOR 7,1
710 FOR I=1 TO 7
720  FOR J=I TO 7
730 	LOCATE (I+3),(45-(J*5))
740 	IF VISIPTR(J)=I THEN C$=STACK$(J,I):GOSUB 2840:PRINT STACK$(J,I);:COLOR 7,1 ELSE FOR X=1 TO 3:PRINT CHR$(254);:NEXT X
750  NEXT J
760 NEXT I
