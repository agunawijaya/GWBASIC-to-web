1170 IF K$="P" OR K$="p" THEN 1300
1180 IF K$>="1"AND K$<="7" THEN 1860
1190 IF K$="Q" OR K$="q" THEN FLAG=0:GOTO 300
1200 IF K$="C" OR K$="c" THEN  2610
